{
  "name": "bunny-rabbit",
  "version": "0.1.0",
  "private": true,
  "description": "Bunny-Rabbit ops monorepo — travel planner microservice + Obsidian ops docs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@bunny-rabbit/web",
    "build:edge": "npm run build --workspace=@bunny-rabbit/edge",
    "dev": "npm run dev --workspace=@bunny-rabbit/web",
    "lint": "npm run lint --workspace=@bunny-rabbit/web",
    "typecheck": "npm run typecheck --workspace=@bunny-rabbit/web"
  },
  "engines": {
    "node": "24.x"
  }
}

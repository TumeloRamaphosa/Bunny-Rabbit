# Bunny Rabbit — travel microservice (placeholders only)

# --- Vercel (apps/web) ---
# Set in Vercel project → Settings → Environment Variables
NEXT_PUBLIC_APP_URL=https://your-travel-app.vercel.app
# Optional analytics (leave empty if unused)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Cloudflare Worker (workers/edge) ---
# wrangler secret put VERCEL_ORIGIN_URL
VERCEL_ORIGIN_URL=https://your-travel-app.vercel.app
SERVICE_NAME=bunny-rabbit-travel

# --- Studex fleet / LiteLLM gateway (optional cross-service) ---
# LITELLM_GATEWAY_URL=http://localhost:4000
# LITELLM_API_KEY=your-litellm-key

# --- Local dev ---
PORT=3000
